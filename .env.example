# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/taskmanager
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskmanager?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/taskmanager

# JWT Secret Key for Authentication
JWT_SECRET=super_secret_jwt_key_task_manager_2026_change_in_production
JWT_EXPIRES_IN=7d
